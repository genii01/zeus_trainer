name: "mobilenet_v2"
backend: "onnxruntime"
max_batch_size: 0
input [{ name: "input" data_type: TYPE_FP32 dims: [1, 3, 224, 224] }]
output [{ name: "logits" data_type: TYPE_FP32 dims: [1, 1000] }]
instance_group [{ count: 1 kind: KIND_CPU }]
version_policy: { specific: { versions: [1] } }
parameters { key: "intra_op_thread_count" value: { string_value: "2" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }
