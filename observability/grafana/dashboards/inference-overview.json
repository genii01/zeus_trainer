{
  "uid": "inference-overview",
  "title": "MobileNet Inference Overview",
  "tags": ["inference", "mobilenet", "triton"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "title": "FastAPI requests / second", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "No data"}}, "targets": [{"refId": "A", "expr": "sum by (method, route) (rate(api_requests_total[1m]))", "legendFormat": "{{method}} {{route}}"}]},
    {"id": 2, "title": "FastAPI error rate", "type": "timeseries", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "noValue": "No data"}}, "targets": [{"refId": "A", "expr": "sum(rate(api_requests_total{status=~\"4..|5..\"}[1m])) / sum(rate(api_requests_total[1m]))", "legendFormat": "error ratio"}]},
    {"id": 3, "title": "FastAPI request latency", "type": "timeseries", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, route) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{route}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{route}}"}]},
    {"id": 4, "title": "Triton roundtrip p95 (FastAPI)", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(api_inference_duration_seconds_bucket[5m])))", "legendFormat": "{{model}}"}]},
    {"id": 5, "title": "Inflight API requests", "type": "timeseries", "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"noValue": "No data"}}, "targets": [{"refId": "A", "expr": "api_inflight_requests", "legendFormat": "inflight"}]},
    {"id": 6, "title": "Upstream errors / second", "type": "timeseries", "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}}, "targets": [{"refId": "A", "expr": "sum by (reason) (rate(api_upstream_errors_total[1m]))", "legendFormat": "{{reason}}"}]},
    {"id": 7, "title": "Triton successes and failures / second", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "No data"}}, "targets": [{"refId": "A", "expr": "sum by (model, version) (rate(nv_inference_request_success[1m]))", "legendFormat": "success {{model}} v{{version}}"}, {"refId": "B", "expr": "sum by (model, version) (rate(nv_inference_request_failure[1m]))", "legendFormat": "failure {{model}} v{{version}}"}]},
    {"id": 8, "title": "Triton mean request, queue, and compute latency", "type": "timeseries", "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "ms", "noValue": "No data"}}, "targets": [{"refId": "A", "expr": "sum by (model, version) (rate(nv_inference_request_duration_us[1m])) / sum by (model, version) (rate(nv_inference_request_success[1m])) / 1000", "legendFormat": "request {{model}} v{{version}}"}, {"refId": "B", "expr": "sum by (model, version) (rate(nv_inference_queue_duration_us[1m])) / sum by (model, version) (rate(nv_inference_request_success[1m])) / 1000", "legendFormat": "queue {{model}} v{{version}}"}, {"refId": "C", "expr": "sum by (model, version) (rate(nv_inference_compute_infer_duration_us[1m])) / sum by (model, version) (rate(nv_inference_request_success[1m])) / 1000", "legendFormat": "compute {{model}} v{{version}}"}]},
    {"id": 9, "title": "Triton inference count / second", "type": "timeseries", "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "No data"}}, "targets": [{"refId": "A", "expr": "sum by (model, version) (rate(nv_inference_count[1m]))", "legendFormat": "{{model}} v{{version}}"}]},
    {"id": 10, "title": "Scrape target health", "type": "stat", "gridPos": {"x": 0, "y": 24, "w": 24, "h": 5}, "fieldConfig": {"defaults": {"noValue": "No data", "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}, "targets": [{"refId": "A", "expr": "up{job=~\"api|triton\"}", "legendFormat": "{{job}} {{instance}}"}]}
  ]
}
